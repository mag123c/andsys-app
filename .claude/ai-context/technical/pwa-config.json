{
  "$schema": "ai-context/technical/pwa-config",
  "version": "1.2.0",
  "description": "PWA 구성 및 환경별 동작 정의",
  "terminology": {
    "오프라인": "인터넷 연결 없음",
    "로컬 환경": "PWA 앱 (standalone 모드)",
    "클라우드 환경": "웹 브라우저"
  },
  "browserSupport": {
    "chrome": {
      "desktop": "완전 지원",
      "android": "완전 지원",
      "features": ["beforeinstallprompt", "ServiceWorker", "standalone"]
    },
    "edge": {
      "desktop": "완전 지원",
      "features": ["beforeinstallprompt", "ServiceWorker", "standalone"]
    },
    "safari": {
      "desktop": "미지원",
      "ios": "제한적",
      "features": [],
      "limitations": [
        "beforeinstallprompt 이벤트 미지원 → InstallPrompt 표시 안됨",
        "사용자가 직접 '홈 화면에 추가' 선택 필요",
        "iOS Safari에서 Home Screen 추가 시 ServiceWorker 미지원",
        "오프라인 저장 및 수동 동기화 불가"
      ],
      "note": "macOS Safari에서는 PWA 기능 전혀 없음"
    },
    "firefox": {
      "desktop": "제한적",
      "features": ["ServiceWorker"],
      "limitations": ["beforeinstallprompt 미지원"]
    }
  },
  "implementation": {
    "serviceWorker": {
      "file": "src/app/sw.ts",
      "library": "Serwist (@serwist/next)",
      "config": "next.config.ts (withSerwist)"
    },
    "manifest": "public/manifest.json",
    "icons": {
      "path": "public/icons/",
      "sizes": ["192x192", "512x512", "maskable-512", "apple-touch"]
    },
    "detection": {
      "isPWA": "src/lib/pwa.ts",
      "usePWAMode": "src/hooks/usePWAMode.ts"
    }
  },
  "components": {
    "InstallPrompt": {
      "path": "src/components/features/pwa/InstallPrompt.tsx",
      "location": "page.tsx (랜딩), NovelsListLayout.tsx (대시보드)",
      "shows": "브라우저에서 설치 가능할 때 (24시간 dismiss 정책)",
      "hooks": ["usePWAInstall"],
      "dismissPolicy": "pwa-storage.ts (24시간 만료)"
    },
    "ManualInstallGuide": {
      "path": "src/components/features/pwa/ManualInstallGuide.tsx",
      "location": "layout.tsx",
      "shows": "Safari/Firefox에서 beforeinstallprompt 미지원 시",
      "hooks": ["usePWAInstall"],
      "dismissPolicy": "pwa-storage.ts (24시간 만료)"
    },
    "OpenInAppButton": {
      "path": "src/components/features/pwa/OpenInAppButton.tsx",
      "location": "NovelsListSidebar.tsx",
      "shows": "브라우저에서 앱 설치된 경우",
      "hooks": ["usePWAInstall"]
    },
    "SidebarInstallButton": {
      "path": "src/components/features/workspace/NovelsListSidebar.tsx",
      "location": "NovelsListSidebar 메뉴",
      "shows": "브라우저 모드에서 (설치 불가 시 disabled)",
      "hooks": ["usePWAInstall"]
    },
    "UpdatePrompt": {
      "path": "src/components/features/pwa/UpdatePrompt.tsx",
      "location": "layout.tsx",
      "shows": "SW 업데이트 감지 시 (자동 리로드)"
    },
    "PWASyncButton": {
      "path": "src/components/features/pwa/PWASyncButton.tsx",
      "location": "DashboardHeader.tsx",
      "shows": "로컬 환경(PWA)에서만"
    },
    "SyncStatusIndicator": {
      "path": "src/components/features/sync/SyncStatusIndicator.tsx",
      "location": "DashboardHeader.tsx",
      "shows": "클라우드 환경(브라우저)에서만"
    }
  },
  "dismissPolicy": {
    "storage": "src/lib/pwa-storage.ts",
    "key": "pwa-prompt-dismissed",
    "format": "JSON { timestamp: number }",
    "duration": "24시간 (86400000ms)",
    "behavior": "만료 후 자동 재표시"
  },
  "syncBehavior": {
    "local": {
      "environment": "PWA (standalone)",
      "detection": "usePWAMode() === true",
      "autoSync": false,
      "syncTrigger": "PWASyncButton 클릭",
      "loginRequired": "동기화 시에만",
      "implementation": "useSyncEngine.ts (isPwaMode 분기)"
    },
    "cloud_member": {
      "environment": "브라우저 + 로그인",
      "detection": "usePWAMode() === false && auth.status === 'authenticated'",
      "autoSync": true,
      "debounce": 2000,
      "realtime": "Supabase Realtime 구독"
    },
    "cloud_nonMember": {
      "environment": "브라우저 + 비로그인",
      "detection": "usePWAMode() === false && auth.status === 'guest'",
      "autoSync": false,
      "storage": "IndexedDB only"
    }
  },
  "phases": {
    "phase1": {
      "name": "기본 PWA 설정",
      "status": "completed",
      "items": ["manifest.json", "sw.ts", "icons", "메타데이터", "pwa.ts", "usePWAMode"]
    },
    "phase2": {
      "name": "PWA 전용 UI",
      "status": "completed",
      "items": ["InstallPrompt", "UpdatePrompt", "PWASyncButton"]
    },
    "phase3": {
      "name": "환경별 동기화 로직",
      "status": "completed",
      "items": ["useSyncEngine isPwaMode 분기", "SyncStatusIndicator PWA 숨김", "비회원 로그인 유도"]
    },
    "phase4": {
      "name": "최적화",
      "status": "optional",
      "items": ["Cache API 최적화", "캐시 용량 관리"]
    }
  },
  "keyFiles": [
    "src/app/sw.ts",
    "src/lib/pwa.ts",
    "src/lib/pwa-storage.ts",
    "src/hooks/usePWAMode.ts",
    "src/hooks/usePWAInstall.tsx",
    "src/hooks/useSyncEngine.ts",
    "src/components/features/pwa/InstallPrompt.tsx",
    "src/components/features/pwa/ManualInstallGuide.tsx",
    "src/components/features/pwa/UpdatePrompt.tsx",
    "src/components/features/pwa/OpenInAppButton.tsx",
    "src/components/features/pwa/PWASyncButton.tsx",
    "src/components/features/sync/SyncStatusIndicator.tsx",
    "public/manifest.json",
    "next.config.ts"
  ]
}
