{
  "$schema": "ai-context/domain/rules",
  "version": "2.0.0",
  "description": "비즈니스 규칙 정의",
  "rules": {
    "CASCADE_DELETE": {
      "description": "프로젝트 삭제 시 모든 하위 데이터 함께 삭제",
      "entities": ["chapters", "synopses", "characters", "relationships", "versions"],
      "implementation": "hooks/useProject.ts → deleteProject()"
    },
    "LOGIN_BASED_SYNC": {
      "description": "로그인 여부에 따른 동기화 방식 분리",
      "guest": {
        "description": "비로그인 (로컬 모드): 동기화 없음",
        "autoSync": false,
        "storage": "IndexedDB만",
        "badge": "로컬"
      },
      "member": {
        "description": "로그인 (클라우드 모드): 서버 백업",
        "autoSync": true,
        "syncTrigger": "저장 후 debounce 2초 (브라우저), 수동 버튼 (PWA)",
        "storage": "IndexedDB + Supabase",
        "badge": "클라우드"
      },
      "implementation": "sync/sync-engine.ts, hooks/useSyncEngine.ts"
    },
    "ONE_SYNOPSIS_PER_PROJECT": {
      "description": "프로젝트당 시놉시스 1개만 존재",
      "implementation": "hooks/useSynopsis.ts → getOrCreate()"
    },
    "LOCAL_FIRST_SAVE": {
      "description": "모든 저장은 IndexedDB 먼저 (환경 무관)",
      "implementation": "storage/local/*.ts"
    },
    "LATEST_WINS_CONFLICT": {
      "description": "동기화 충돌 시 updatedAt이 최신인 데이터 우선",
      "implementation": "sync/sync-engine.ts → resolveConflict()"
    },
    "IMAGE_DUAL_STORAGE": {
      "description": "이미지는 로컬에 Base64, 서버에 Storage URL로 저장",
      "localFields": ["coverImageBase64", "imageBase64"],
      "remoteFields": ["coverImageUrl", "imageUrl"],
      "implementation": "lib/image-utils.ts, sync/sync-engine.ts"
    },
    "IMAGE_RESIZE": {
      "description": "업로드된 이미지는 지정 크기로 리사이즈",
      "coverImage": "100x150",
      "characterImage": "100x150",
      "implementation": "lib/image-utils.ts → resizeImage()"
    },
    "CHAPTER_ORDER": {
      "description": "챕터는 order 필드로 정렬, 생성 시 자동 증가, 삭제 시 재정렬하지 않음 (빈 번호 허용)",
      "implementation": "hooks/useChapters.ts → createChapter()",
      "note": "사용자가 회차 번호를 직접 편집하거나 드래그로 재정렬 가능"
    },
    "CHARACTER_ORDER": {
      "description": "캐릭터는 order 필드로 정렬, 드래그앤드롭으로 재정렬 가능",
      "implementation": "hooks/useCharacters.ts → reorderCharacters()"
    },
    "BIDIRECTIONAL_RELATIONSHIP": {
      "description": "관계는 양방향(bidirectional) 설정 가능. true면 양쪽에서 동일하게 표시",
      "implementation": "components/features/relationship/RelationshipDialog.tsx"
    },
    "VERSION_HISTORY_LOCAL_ONLY": {
      "description": "버전 히스토리는 로컬 전용, 서버 동기화 없음",
      "reason": "히스토리 데이터가 방대해질 수 있어 로컬에서만 관리",
      "entities": ["synopsis", "character"]
    }
  },
  "policies": {
    "guest": {
      "description": "비로그인 사용자 (로컬 모드)",
      "badge": "로컬",
      "storage": "IndexedDB only",
      "sync": false,
      "risk": "브라우저 데이터 삭제 시 복구 불가",
      "limitations": ["서버 백업 없음", "다른 기기 접근 불가", "공유 기능 제한"]
    },
    "member": {
      "description": "로그인 사용자 (클라우드 모드)",
      "badge": "클라우드",
      "storage": "IndexedDB + Supabase",
      "sync": {
        "browser": "자동 (debounce 2초)",
        "pwa": "수동 버튼"
      },
      "realtime": "Supabase Realtime 구독",
      "multiDevice": true,
      "benefit": "브라우저 데이터 삭제해도 로그인하면 복구"
    },
    "pwa": {
      "description": "PWA 설치 시 추가 정책",
      "note": "설치 방식의 차이일 뿐, 로그인 여부가 데이터 안전성 결정",
      "offlineSupport": "Chrome/Edge에서 완전 지원",
      "syncMethod": "수동 버튼 (오프라인 작업 지원 위해)"
    }
  },
  "autosave": {
    "delay": 2000,
    "unit": "ms",
    "trigger": "content 변경 시",
    "target": "IndexedDB (환경 무관)"
  }
}
